# Civic Connect Backend Environment Configuration (Template)
# Copy this file to .env and fill in your actual credentials

SUPABASE_URL=https://<your-project-id>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_<your-key>
SUPABASE_SECRET_KEY=sb_secret_<your-key>
# Use the Session Pooler string (Supabase dashboard > Connect > Session pooler).
# The direct db.<project-id>.supabase.co host is IPv6-only and fails on most IPv4 networks.
DATABASE_URL=postgresql://postgres.<your-project-id>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
